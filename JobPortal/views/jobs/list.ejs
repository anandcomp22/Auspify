<div class="container" style="padding: var(--space-12) 0;">
  <!-- Breadcrumb & Header -->
  <div style="margin-bottom: var(--space-6); font-size: var(--font-size-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--text-muted);">
    <a href="/" style="color: var(--text-secondary);">Home</a> / 
    <span style="color: var(--color-primary); font-weight: 700;">Open Positions</span>
  </div>

  <div class="section-header">
    <div>
      <h1 class="section-title">Explore Open Positions</h1>
      <p class="section-subtitle">
        Found <%= pagination.totalCount %> verified opening<%= pagination.totalCount === 1 ? '' : 's' %> matching active filters.
      </p>
    </div>
    <% if (user && (user.role === 'employer' || user.role === 'admin')) { %>
      <a href="/jobs/create" class="btn btn-accent btn-sm">Publish New Position</a>
    <% } %>
  </div>

  <!-- Search & Filter Controls -->
  <form action="/jobs" method="GET" class="search-panel">
    <div class="search-form-grid">
      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label" for="search-q">Keywords / Stack</label>
        <input 
          type="text" 
          id="search-q"
          name="q" 
          class="form-input" 
          placeholder="e.g. Distributed, Rust, Staff, Frontend, Go"
          value="<%= filters.q || '' %>"
        >
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label" for="search-loc">Location</label>
        <input 
          type="text" 
          id="search-loc"
          name="location" 
          class="form-input" 
          placeholder="e.g. Remote, San Francisco, New York"
          value="<%= filters.location || '' %>"
        >
      </div>

      <button type="submit" class="btn btn-primary" style="height: 44px;">
        Filter Listings
      </button>
    </div>

    <!-- Secondary Filters Row -->
    <div class="filter-bar">
      <div>
        <select name="work_type" class="filter-select auto-submit-filter">
          <option value="">All Work Models</option>
          <option value="remote" <%= filters.work_type === 'remote' ? 'selected' : '' %>>Remote</option>
          <option value="onsite" <%= filters.work_type === 'onsite' ? 'selected' : '' %>>Onsite</option>
          <option value="hybrid" <%= filters.work_type === 'hybrid' ? 'selected' : '' %>>Hybrid</option>
        </select>
      </div>

      <div>
        <select name="job_type" class="filter-select auto-submit-filter">
          <option value="">All Employment Types</option>
          <option value="full-time" <%= filters.job_type === 'full-time' ? 'selected' : '' %>>Full-Time</option>
          <option value="part-time" <%= filters.job_type === 'part-time' ? 'selected' : '' %>>Part-Time</option>
          <option value="contract" <%= filters.job_type === 'contract' ? 'selected' : '' %>>Contract</option>
          <option value="internship" <%= filters.job_type === 'internship' ? 'selected' : '' %>>Internship</option>
        </select>
      </div>

      <div>
        <select name="experience_level" class="filter-select auto-submit-filter">
          <option value="">All Seniority Levels</option>
          <option value="entry" <%= filters.experience_level === 'entry' ? 'selected' : '' %>>Entry-Level</option>
          <option value="mid" <%= filters.experience_level === 'mid' ? 'selected' : '' %>>Mid-Level</option>
          <option value="senior" <%= filters.experience_level === 'senior' ? 'selected' : '' %>>Senior</option>
          <option value="lead" <%= filters.experience_level === 'lead' ? 'selected' : '' %>>Lead / Staff</option>
          <option value="executive" <%= filters.experience_level === 'executive' ? 'selected' : '' %>>Executive</option>
        </select>
      </div>

      <div>
        <select name="sort" class="filter-select auto-submit-filter">
          <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Sort: Most Recent</option>
          <option value="salary_desc" <%= filters.sort === 'salary_desc' ? 'selected' : '' %>>Sort: Highest Salary</option>
          <option value="salary_asc" <%= filters.sort === 'salary_asc' ? 'selected' : '' %>>Sort: Lowest Salary</option>
          <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Sort: Oldest</option>
        </select>
      </div>

      <% if (filters.q || filters.location || filters.work_type || filters.job_type || filters.experience_level || filters.sort !== 'newest') { %>
        <a href="/jobs" class="btn btn-ghost btn-sm" style="color: var(--color-accent); font-weight: 700;">Clear Filters</a>
      <% } %>
    </div>
  </form>

  <!-- Job Listings Grid -->
  <% if (jobs && jobs.length > 0) { %>
    <div class="jobs-grid">
      <% jobs.forEach(function(job) { %>
        <div class="job-card">
          <div>
            <div class="job-card-top">
              <span class="job-company"><%= job.company %></span>
              <span class="job-date"><%= new Date(job.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
            </div>
            
            <h2 class="job-title" style="font-size: var(--font-size-md);">
              <a href="/jobs/<%= job.id %>"><%= job.title %></a>
            </h2>

            <div class="job-meta-row">
              <span class="badge badge-<%= job.work_type %>"><%= job.work_type %></span>
              <span class="tag"><%= job.job_type %></span>
              <span class="tag"><%= job.experience_level %></span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-3);">
              <span class="job-location"><%= job.location %></span>
              <% if (job.salary_min && job.salary_max) { %>
                <span class="job-salary">
                  $<%= (job.salary_min / 1000).toFixed(0) %>k - $<%= (job.salary_max / 1000).toFixed(0) %>k
                </span>
              <% } %>
            </div>

            <p class="job-snippet"><%= job.description %></p>
          </div>

          <div>
            <% if (job.skills) { %>
              <div class="job-tags" style="margin-bottom: var(--space-4);">
                <% job.skills.split(',').slice(0, 4).forEach(function(s) { %>
                  <span class="tag"><%= s.trim() %></span>
                <% }); %>
              </div>
            <% } %>

            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-light); padding-top: var(--space-3);">
              <span style="font-size: var(--font-size-xs); color: var(--text-muted); font-family: var(--font-family-mono);">
                <%= job.applications_count || 0 %> applicant<%= job.applications_count === 1 ? '' : 's' %>
              </span>
              <a href="/jobs/<%= job.id %>" class="btn btn-outline btn-sm">Inspect Position &rarr;</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Pagination Controls -->
    <% if (pagination.totalPages > 1) { %>
      <div class="pagination">
        <% 
          function buildPageUrl(p) {
            const params = new URLSearchParams();
            if (filters.q) params.set('q', filters.q);
            if (filters.location) params.set('location', filters.location);
            if (filters.work_type) params.set('work_type', filters.work_type);
            if (filters.job_type) params.set('job_type', filters.job_type);
            if (filters.experience_level) params.set('experience_level', filters.experience_level);
            if (filters.sort) params.set('sort', filters.sort);
            params.set('page', p);
            return '/jobs?' + params.toString();
          }
        %>

        <% if (pagination.hasPrev) { %>
          <a href="<%= buildPageUrl(pagination.currentPage - 1) %>" class="page-btn">&larr; Previous</a>
        <% } %>

        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
          <a href="<%= buildPageUrl(i) %>" class="page-btn <%= i === pagination.currentPage ? 'active' : '' %>"><%= i %></a>
        <% } %>

        <% if (pagination.hasNext) { %>
          <a href="<%= buildPageUrl(pagination.currentPage + 1) %>" class="page-btn">Next &rarr;</a>
        <% } %>
      </div>
    <% } %>

  <% } else { %>
    <div class="empty-state">
      <h3 class="empty-state-title">No Matching Positions Found</h3>
      <p class="empty-state-desc">
        We could not find active vacancies matching your current query parameters. Try loosening keyword criteria or location filters.
      </p>
      <a href="/jobs" class="btn btn-outline">Reset Filter Parameters</a>
    </div>
  <% } %>
</div>

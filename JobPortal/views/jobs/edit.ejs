<div class="container container-narrow" style="padding: var(--space-12) 0;">
  <!-- Breadcrumb -->
  <div style="margin-bottom: var(--space-6); font-size: var(--font-size-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--text-muted);">
    <a href="/dashboard" style="color: var(--text-secondary);">Workspace</a> / 
    <a href="/jobs/<%= job.id %>" style="color: var(--text-secondary);"><%= job.title %></a> / 
    <span style="color: var(--color-primary); font-weight: 700;">Edit Specification</span>
  </div>

  <div class="section-header">
    <div>
      <h1 class="section-title">Modify Position Specification</h1>
      <p class="section-subtitle">Update compensation terms, criteria, or change availability state.</p>
    </div>
  </div>

  <% if (errors && errors.length > 0) { %>
    <div class="alert alert-error">
      <div>
        <% errors.forEach(function(e) { %>
          <div><%= e.msg %></div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <div class="card">
    <form action="/jobs/<%= job.id %>/edit" method="POST">
      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-4);">
        <div class="form-group">
          <label class="form-label" for="title">Position Title</label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            class="form-input" 
            required 
            value="<%= job.title %>"
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="company">Company Entity</label>
          <input 
            type="text" 
            id="company" 
            name="company" 
            class="form-input" 
            required 
            value="<%= job.company %>"
          >
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--space-4);">
        <div class="form-group">
          <label class="form-label" for="location">Location Base</label>
          <input 
            type="text" 
            id="location" 
            name="location" 
            class="form-input" 
            required 
            value="<%= job.location %>"
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="work_type">Work Operating Model</label>
          <select id="work_type" name="work_type" class="form-select" required>
            <option value="remote" <%= job.work_type === 'remote' ? 'selected' : '' %>>Remote</option>
            <option value="hybrid" <%= job.work_type === 'hybrid' ? 'selected' : '' %>>Hybrid</option>
            <option value="onsite" <%= job.work_type === 'onsite' ? 'selected' : '' %>>Onsite</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="job_type">Employment Model</label>
          <select id="job_type" name="job_type" class="form-select" required>
            <option value="full-time" <%= job.job_type === 'full-time' ? 'selected' : '' %>>Full-Time</option>
            <option value="contract" <%= job.job_type === 'contract' ? 'selected' : '' %>>Contract</option>
            <option value="part-time" <%= job.job_type === 'part-time' ? 'selected' : '' %>>Part-Time</option>
            <option value="internship" <%= job.job_type === 'internship' ? 'selected' : '' %>>Internship</option>
          </select>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: var(--space-4);">
        <div class="form-group">
          <label class="form-label" for="experience_level">Seniority Level</label>
          <select id="experience_level" name="experience_level" class="form-select">
            <option value="entry" <%= job.experience_level === 'entry' ? 'selected' : '' %>>Entry-Level</option>
            <option value="mid" <%= job.experience_level === 'mid' ? 'selected' : '' %>>Mid-Level</option>
            <option value="senior" <%= job.experience_level === 'senior' ? 'selected' : '' %>>Senior</option>
            <option value="lead" <%= job.experience_level === 'lead' ? 'selected' : '' %>>Lead / Staff</option>
            <option value="executive" <%= job.experience_level === 'executive' ? 'selected' : '' %>>Executive</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="salary_min">Min Compensation</label>
          <input 
            type="number" 
            id="salary_min" 
            name="salary_min" 
            class="form-input" 
            value="<%= job.salary_min || '' %>"
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="salary_max">Max Compensation</label>
          <input 
            type="number" 
            id="salary_max" 
            name="salary_max" 
            class="form-input" 
            value="<%= job.salary_max || '' %>"
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="currency">Currency</label>
          <select id="currency" name="currency" class="form-select">
            <option value="USD" <%= job.currency === 'USD' ? 'selected' : '' %>>USD ($)</option>
            <option value="EUR" <%= job.currency === 'EUR' ? 'selected' : '' %>>EUR (€)</option>
            <option value="GBP" <%= job.currency === 'GBP' ? 'selected' : '' %>>GBP (£)</option>
            <option value="CAD" <%= job.currency === 'CAD' ? 'selected' : '' %>>CAD ($)</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="skills">Indexed Tech Stack & Skills</label>
        <input 
          type="text" 
          id="skills" 
          name="skills" 
          class="form-input" 
          value="<%= job.skills || '' %>"
        >
      </div>

      <div class="form-group">
        <label class="form-label" for="description">Position Responsibilities</label>
        <textarea 
          id="description" 
          name="description" 
          class="form-textarea" 
          rows="6" 
          required
        ><%= job.description %></textarea>
      </div>

      <div class="form-group">
        <label class="form-label" for="requirements">Prerequisites & Qualification Criteria</label>
        <textarea 
          id="requirements" 
          name="requirements" 
          class="form-textarea" 
          rows="5"
        ><%= job.requirements || '' %></textarea>
      </div>

      <div class="form-group">
        <label class="form-label" for="status">Publication State</label>
        <select id="status" name="status" class="form-select" style="max-width: 260px;">
          <option value="active" <%= job.status === 'active' ? 'selected' : '' %>>Active (Public Discovery)</option>
          <option value="closed" <%= job.status === 'closed' ? 'selected' : '' %>>Closed (Applications Stopped)</option>
          <option value="draft" <%= job.status === 'draft' ? 'selected' : '' %>>Draft</option>
        </select>
      </div>

      <div class="card-footer">
        <a href="/jobs/<%= job.id %>" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-primary">Update Listing</button>
      </div>
    </form>
  </div>
</div>

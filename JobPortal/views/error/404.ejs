<div class="container container-narrow" style="padding: var(--space-20) 0; text-align: center;">
  <div class="mono-tag" style="margin-bottom: var(--space-2); color: var(--color-accent);">Status 404 &bull; Resource Unresolved</div>
  <h1 style="font-size: clamp(3rem, 8vw, 5rem); line-height: 1; margin-bottom: var(--space-4); letter-spacing: -0.05em;">
    Not Located
  </h1>
  <p style="font-size: var(--font-size-lg); color: var(--text-secondary); max-width: 480px; margin: 0 auto var(--space-8);">
    The requested URI does not resolve to an active position, profile, or operational endpoint.
  </p>
  <div style="display: flex; justify-content: center; gap: var(--space-4);">
    <a href="/" class="btn btn-primary">Return to Index</a>
    <a href="/jobs" class="btn btn-outline">Browse Positions</a>
  </div>
</div>

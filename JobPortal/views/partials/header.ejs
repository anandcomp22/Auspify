<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-mark">
      <span class="brand-emblem">H</span>
      <span>HireScope</span>
    </a>

    <button type="button" class="mobile-nav-toggle" aria-label="Toggle navigation">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
        <rect y="3" width="20" height="2" fill="#141414"/>
        <rect y="9" width="20" height="2" fill="#141414"/>
        <rect y="15" width="20" height="2" fill="#141414"/>
      </svg>
    </button>

    <ul class="nav-links">
      <li>
        <a href="/jobs" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/jobs') && currentPath !== '/jobs/create' ? 'active' : '' %>">Open Positions</a>
      </li>
      <% if (user && (user.role === 'employer' || user.role === 'admin')) { %>
        <li>
          <a href="/jobs/create" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/jobs/create' ? 'active' : '' %>">Publish Listing</a>
        </li>
      <% } %>
      <% if (user && user.role === 'admin') { %>
        <li>
          <a href="/admin" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/admin') ? 'active' : '' %>">Administration</a>
        </li>
      <% } %>
    </ul>

    <div class="nav-actions">
      <% if (user) { %>
        <div class="user-status-pill">
          <span><%= user.name %></span>
          <span class="user-status-role"><%= user.role %></span>
        </div>
        <a href="/dashboard" class="btn btn-outline btn-sm">Workspace</a>
        <a href="/auth/profile" class="btn btn-ghost btn-sm">Settings</a>
        <form action="/auth/logout" method="POST" style="display: inline;">
          <button type="submit" class="btn btn-ghost btn-sm">Sign Out</button>
        </form>
      <% } else { %>
        <a href="/auth/login" class="btn btn-ghost btn-sm">Sign In</a>
        <a href="/auth/register" class="btn btn-primary btn-sm">Get Started</a>
      <% } %>
    </div>
  </div>
</header>

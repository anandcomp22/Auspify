<div class="container container-narrow" style="padding: var(--space-16) 0;">
  <div style="max-width: 440px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: var(--space-8);">
      <a href="/" class="brand-mark" style="margin-bottom: var(--space-3); display: inline-flex;">
        <span class="brand-emblem">H</span>
        <span>HireScope</span>
      </a>
      <h1 style="font-size: var(--font-size-2xl); margin-top: var(--space-2);">Sign In to Workspace</h1>
      <p style="font-size: var(--font-size-sm); color: var(--text-secondary); margin-top: var(--space-1);">
        Access your candidate applications or employer dashboard.
      </p>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-error">
        <div>
          <% errors.forEach(function(e) { %>
            <div><%= e.msg %></div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <div class="card">
      <form action="/auth/login" method="POST">
        <div class="form-group">
          <label class="form-label" for="email">Account Email</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-input" 
            value="<%= (oldInput && oldInput.email) ? oldInput.email : '' %>" 
            required 
            autocomplete="email"
            placeholder="name@company.com"
          >
        </div>

        <div class="form-group">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-2);">
            <label class="form-label" for="password" style="margin-bottom: 0;">Password</label>
          </div>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="form-input" 
            required 
            autocomplete="current-password"
            placeholder="Enter account password"
          >
        </div>

        <button type="submit" class="btn btn-primary btn-block" style="margin-top: var(--space-4);">
          Sign In
        </button>
      </form>

      <div style="margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--border-light); font-size: var(--font-size-xs); color: var(--text-muted); text-align: center;">
        Demonstration Credentials:<br>
        <strong>Admin:</strong> admin@jobportal.com / admin123<br>
        <strong>Employer:</strong> elena@strataworks.io / employer123<br>
        <strong>Seeker:</strong> alex@example.com / seeker123
      </div>
    </div>

    <div style="text-align: center; margin-top: var(--space-6); font-size: var(--font-size-sm); color: var(--text-secondary);">
      Do not have an account? <a href="/auth/register" style="font-weight: 700; color: var(--color-accent);">Create Account</a>
    </div>
  </div>
</div>

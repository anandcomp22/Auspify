<div class="container section-editorial">
  <div style="max-width: 540px; margin: 2rem auto;">
    <div class="panel" style="padding: 2.5rem;">
      <div class="index-tag accent" style="margin-bottom: 0.75rem;">
        [ ENROLLMENT PORTAL // IDENTITY ONBOARDING ]
      </div>

      <h1 style="font-size: 1.85rem; margin-bottom: 0.5rem;">
        Enroll Academic Profile
      </h1>
      
      <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 2rem;">
        Create your student researcher or faculty author account to access the engineering platform.
      </p>

      <% if (errors && errors.length > 0) { %>
        <div class="alert alert-error">
          <ul style="margin-left: 1rem;">
            <% errors.forEach(err => { %>
              <li><%= err %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/auth/register" method="POST">
        <div class="form-group">
          <label class="form-label" for="role">Account Role Classification</label>
          <select id="role" name="role" class="form-select" required>
            <option value="student" <%= (formData && formData.role === 'student') ? 'selected' : '' %>>Student Researcher</option>
            <option value="instructor" <%= (formData && formData.role === 'instructor') ? 'selected' : '' %>>Instructor / Course Author</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="name">Full Academic Name</label>
          <input type="text" id="name" name="name" class="form-input" value="<%= formData ? formData.name || '' : '' %>" required placeholder="e.g. Elena Rostova">
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Institutional Email Address</label>
          <input type="email" id="email" name="email" class="form-input" value="<%= formData ? formData.email || '' : '' %>" required placeholder="username@auspify.edu">
        </div>

        <div class="form-group">
          <label class="form-label" for="headline">Academic Focus / Title</label>
          <input type="text" id="headline" name="headline" class="form-input" value="<%= formData ? formData.headline || '' : '' %>" placeholder="e.g. Systems Programming Senior or Distributed Systems Specialist">
        </div>

        <div class="grid-cols-2">
          <div class="form-group">
            <label class="form-label" for="password">Password</label>
            <input type="password" id="password" name="password" class="form-input" required minlength="8" placeholder="Minimum 8 characters">
          </div>

          <div class="form-group">
            <label class="form-label" for="confirm_password">Confirm Password</label>
            <input type="password" id="confirm_password" name="confirm_password" class="form-input" required placeholder="Re-enter password">
          </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">
          Complete Registration &rarr;
        </button>
      </form>

      <div style="margin-top: 1.5rem; text-align: center; font-size: 0.85rem; color: var(--text-secondary);">
        Already registered? <a href="/auth/login" style="color: var(--accent-primary); font-weight: 600;">Sign in to account</a>
      </div>
    </div>
  </div>
</div>

<div class="container section-editorial">
  <div class="section-header">
    <div>
      <div class="index-tag accent" style="margin-bottom: 0.5rem;">[ CURRICULUM DIRECTORY // 2026 ]</div>
      <h1>Engineering Course Catalog</h1>
    </div>
    
    <% if (typeof currentUser !== 'undefined' && currentUser && ['instructor', 'admin'].includes(currentUser.role)) { %>
      <a href="/instructor/courses/new" class="btn btn-accent btn-sm">
        + Author New Course
      </a>
    <% } %>
  </div>

  <!-- Search and Filtration Controls -->
  <div class="panel" style="margin-bottom: 2.5rem; background-color: var(--bg-surface);">
    <form action="/courses" method="GET" style="display: flex; flex-direction: column; gap: 1.25rem;">
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <input type="text" name="q" class="form-input" placeholder="Search by course code, topic, or keyword (e.g. Raft, Compiler, TLS)..." value="<%= searchQuery %>" style="flex: 1; min-width: 280px;">
        <button type="submit" class="btn btn-primary">Filter Curriculum</button>
        <% if (searchQuery || selectedCategory || selectedDifficulty) { %>
          <a href="/courses" class="btn btn-secondary">Reset Filters</a>
        <% } %>
      </div>

      <!-- Category Filter Pills -->
      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <span class="index-tag" style="margin-right: 0.5rem;">CATEGORY:</span>
        <a href="/courses?<%= selectedDifficulty ? 'difficulty=' + encodeURIComponent(selectedDifficulty) + '&' : '' %>" class="badge <%= !selectedCategory ? 'badge-accent' : 'badge-default' %>" style="text-decoration: none;">
          All Categories
        </a>
        <% categories.forEach(cat => { %>
          <a href="/courses?category=<%= encodeURIComponent(cat) %><%= selectedDifficulty ? '&difficulty=' + encodeURIComponent(selectedDifficulty) : '' %>" class="badge <%= selectedCategory === cat ? 'badge-accent' : 'badge-default' %>" style="text-decoration: none;">
            <%= cat %>
          </a>
        <% }) %>
      </div>

      <!-- Difficulty Filter Pills -->
      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <span class="index-tag" style="margin-right: 0.5rem;">DIFFICULTY:</span>
        <a href="/courses?<%= selectedCategory ? 'category=' + encodeURIComponent(selectedCategory) + '&' : '' %>" class="badge <%= !selectedDifficulty ? 'badge-accent' : 'badge-default' %>" style="text-decoration: none;">
          All Levels
        </a>
        <% ['Introductory', 'Intermediate', 'Advanced'].forEach(lvl => { %>
          <a href="/courses?difficulty=<%= encodeURIComponent(lvl) %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %>" class="badge <%= selectedDifficulty === lvl ? 'badge-accent' : 'badge-default' %>" style="text-decoration: none;">
            <%= lvl %>
          </a>
        <% }) %>
      </div>
    </form>
  </div>

  <!-- Course Grid -->
  <% if (courses && courses.length > 0) { %>
    <div class="grid-cols-3">
      <% courses.forEach(c => { %>
        <div class="panel" style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
              <span class="badge badge-accent"><%= c.code %></span>
              <span class="badge badge-default"><%= c.difficulty %></span>
            </div>

            <h2 style="font-size: 1.25rem; margin-bottom: 0.75rem;">
              <a href="/courses/<%= c.slug %>" style="color: inherit; text-decoration: none;">
                <%= c.title %>
              </a>
            </h2>

            <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.55; margin-bottom: 1.25rem;">
              <%= c.subtitle || c.description.substring(0, 130) + '...' %>
            </p>
          </div>

          <div>
            <div style="border-top: 1px solid var(--border-hairline); padding-top: 1rem; margin-bottom: 1.25rem; display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">
              <span><%= c.lessons_count %> Lessons</span>
              <span><%= c.estimated_hours %> Hours</span>
              <span><%= c.enrolled_count %> Students</span>
            </div>

            <div style="margin-bottom: 1.25rem;">
              <div style="font-size: 0.8rem; font-weight: 600; color: var(--text-primary);"><%= c.instructor_name %></div>
              <div style="font-size: 0.725rem; color: var(--text-muted);"><%= c.instructor_headline %></div>
            </div>

            <a href="/courses/<%= c.slug %>" class="btn btn-primary" style="width: 100%;">
              Inspect Syllabus &rarr;
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="panel" style="text-align: center; padding: 4rem 2rem;">
      <div class="index-tag" style="margin-bottom: 1rem;">[ ZERO MATCHES FOUND ]</div>
      <h3 style="margin-bottom: 0.75rem;">No courses match the specified query filters.</h3>
      <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Try adjusting search terms or clearing selected categories.</p>
      <a href="/courses" class="btn btn-secondary">Clear All Filters</a>
    </div>
  <% } %>
</div>

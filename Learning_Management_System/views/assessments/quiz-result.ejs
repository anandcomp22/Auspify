<div class="container section-editorial">
  <div style="max-width: 820px; margin: 0 auto;">
    <!-- Breadcrumb -->
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; font-family: var(--font-mono); font-size: 0.8rem;">
      <a href="/courses/<%= quiz.course_slug %>" style="color: var(--text-muted); text-decoration: none;"><%= quiz.course_code %></a>
      <span style="color: var(--border-hairline);">/</span>
      <a href="/assessments/quiz/<%= quiz.id %>" style="color: var(--text-muted); text-decoration: none;">EXAMINATION</a>
      <span style="color: var(--border-hairline);">/</span>
      <span style="color: var(--accent-primary);">RESULT AUDIT</span>
    </div>

    <!-- Result Summary Banner -->
    <div class="panel" style="margin-bottom: 2rem; border-left: 4px solid <%= attempt.passed ? 'var(--status-success)' : 'var(--status-danger)' %>;">
      <div style="display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
        <div>
          <span class="index-tag <%= attempt.passed ? 'accent' : '' %>">
            [ EXAMINATION EVALUATION // <%= attempt.passed ? 'PASSED' : 'NEEDS IMPROVEMENT' %> ]
          </span>
          <h1 style="font-size: 2rem; margin-top: 0.35rem;"><%= quiz.title %></h1>
          <div style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
            Candidate Evaluation Timestamp: <%= attempt.completed_at %>
          </div>
        </div>

        <div style="text-align: right;">
          <div style="font-family: var(--font-mono); font-size: 2.25rem; font-weight: 700; color: <%= attempt.passed ? 'var(--status-success)' : 'var(--status-danger)' %>;">
            <%= attempt.percentage %>%
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">
            SCORE: <%= attempt.score %> / <%= attempt.total_points %> POINTS
          </div>
        </div>
      </div>

      <div style="border-top: 1px solid var(--border-hairline); padding-top: 1rem; display: flex; gap: 2rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); flex-wrap: wrap;">
        <span>PASSING CRITERIA: <strong><%= quiz.passing_score %>%</strong></span>
        <span>STATUS: <strong style="color: <%= attempt.passed ? 'var(--status-success)' : 'var(--status-danger)' %>;"><%= attempt.passed ? 'PASSED' : 'DID NOT MEET CRITERIA' %></strong></span>
        <span>TIME RECORDED: <strong><%= attempt.time_spent_secs ? Math.round(attempt.time_spent_secs / 60) + ' mins' : 'N/A' %></strong></span>
      </div>
    </div>

    <!-- Questions Detailed Review & Explanations -->
    <div style="margin-bottom: 2.5rem;">
      <div class="section-header" style="margin-bottom: 1.5rem;">
        <div>
          <div class="index-tag" style="margin-bottom: 0.35rem;">[ QUESTION-BY-QUESTION AUDIT ]</div>
          <h2>Assessment Breakdown & Rationale</h2>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1.75rem;">
        <% questions.forEach((q, idx) => { %>
          <% const isCorrect = q.userResult && q.userResult.isCorrect; %>
          <% const selectedId = q.userResult ? q.userResult.submittedOptionId : null; %>
          
          <div class="panel" style="padding: 1.75rem; border-color: <%= isCorrect ? 'var(--border-hairline)' : 'rgba(185, 28, 28, 0.3)' %>;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; border-bottom: 1px solid var(--border-hairline); padding-bottom: 0.5rem;">
              <span class="index-tag">[ QUESTION 0<%= idx + 1 %> ]</span>
              <span class="badge <%= isCorrect ? 'badge-success' : 'badge-danger' %>">
                <%= isCorrect ? 'CORRECT (+' + q.points + ' PTS)' : 'INCORRECT (0 PTS)' %>
              </span>
            </div>

            <div style="font-size: 1.05rem; font-weight: 600; color: var(--text-primary); margin-bottom: 1rem; line-height: 1.5;">
              <%= q.question_text %>
            </div>

            <% if (q.code_snippet) { %>
              <pre style="margin-bottom: 1.25rem;"><code><%= q.code_snippet %></code></pre>
            <% } %>

            <!-- Evaluated Options -->
            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.25rem;">
              <% q.options.forEach(opt => { %>
                <% const isThisSelected = selectedId === opt.id; %>
                <% const isThisCorrect = opt.is_correct === true; %>

                <div style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: var(--radius-sharp); border: 1px solid <%= isThisCorrect ? 'var(--status-success)' : (isThisSelected ? 'var(--status-danger)' : 'var(--border-hairline)') %>; background-color: <%= isThisCorrect ? 'var(--status-success-bg)' : (isThisSelected ? 'var(--status-danger-bg)' : 'var(--bg-canvas)') %>;">
                  <span style="font-family: var(--font-mono); font-weight: 700; font-size: 0.85rem; color: <%= isThisCorrect ? 'var(--status-success)' : (isThisSelected ? 'var(--status-danger)' : 'var(--text-muted)') %>;">
                    <%= opt.id.toUpperCase() %>:
                  </span>
                  <div style="flex: 1; font-size: 0.9rem; color: var(--text-primary);">
                    <%= opt.text %>
                    <% if (isThisSelected && !isThisCorrect) { %>
                      <strong style="color: var(--status-danger); margin-left: 0.5rem;">[ Your Selection ]</strong>
                    <% } %>
                    <% if (isThisCorrect) { %>
                      <strong style="color: var(--status-success); margin-left: 0.5rem;">[ Correct Answer ]</strong>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>

            <!-- Technical Explanation / Rationale -->
            <% if (q.explanation) { %>
              <div style="padding: 0.85rem 1.15rem; background-color: var(--bg-subtle); border-left: 3px solid var(--accent-primary); font-size: 0.875rem; line-height: 1.6; color: var(--text-secondary);">
                <strong style="color: var(--text-primary); font-family: var(--font-mono); font-size: 0.75rem; display: block; margin-bottom: 0.25rem;">
                  TECHNICAL EXPLANATION:
                </strong>
                <%= q.explanation %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Navigation Actions -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem;">
      <a href="/courses/<%= quiz.course_slug %>" class="btn btn-secondary">
        &larr; Return to Course Overview
      </a>

      <div style="display: flex; gap: 1rem;">
        <a href="/assessments/quiz/<%= quiz.id %>" class="btn btn-secondary">
          Retake Examination
        </a>
        <a href="/dashboard/student" class="btn btn-primary">
          Open Student Workspace &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

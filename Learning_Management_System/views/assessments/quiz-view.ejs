<div class="container section-editorial">
  <div style="max-width: 820px; margin: 0 auto;">
    <!-- Breadcrumb -->
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; font-family: var(--font-mono); font-size: 0.8rem;">
      <a href="/courses/<%= quiz.course_slug %>" style="color: var(--text-muted); text-decoration: none;"><%= quiz.course_code %></a>
      <span style="color: var(--border-hairline);">/</span>
      <span style="color: var(--text-muted);">ASSESSMENTS</span>
      <span style="color: var(--border-hairline);">/</span>
      <span style="color: var(--accent-primary);">EXAMINATION</span>
    </div>

    <!-- Quiz Header Panel -->
    <div class="panel" style="margin-bottom: 2rem;">
      <div style="display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
        <div>
          <span class="index-tag accent">[ ACADEMIC EXAMINATION // TIMED ]</span>
          <h1 style="font-size: 2rem; margin-top: 0.35rem;"><%= quiz.title %></h1>
          <div style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
            COURSE: <%= quiz.course_code %> - <%= quiz.course_title %>
          </div>
        </div>

        <!-- Live Countdown Timer -->
        <div style="background-color: var(--bg-canvas); border: 1px solid var(--border-hairline); padding: 0.75rem 1.25rem; text-align: center;">
          <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">
            TIME REMAINING
          </div>
          <div id="quizTimer" data-time-limit="<%= quiz.time_limit_mins %>" style="font-family: var(--font-mono); font-size: 1.5rem; font-weight: 700; color: var(--text-primary);">
            <%= quiz.time_limit_mins %>:00
          </div>
        </div>
      </div>

      <p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.25rem;">
        <%= quiz.description %>
      </p>

      <div style="border-top: 1px solid var(--border-hairline); padding-top: 1rem; display: flex; gap: 2rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);">
        <span>TIME LIMIT: <strong><%= quiz.time_limit_mins %> Mins</strong></span>
        <span>PASSING SCORE: <strong><%= quiz.passing_score %>%</strong></span>
        <span>ATTEMPTS: <strong><%= attemptsCount %> / <%= quiz.max_attempts %></strong></span>
      </div>
    </div>

    <% if (!canAttempt) { %>
      <div class="alert alert-error" style="margin-bottom: 2rem;">
        Maximum allowable attempts (<%= quiz.max_attempts %>) reached for this examination. Review your past attempt scores below.
      </div>
    <% } else { %>
      <!-- Active Quiz Question Form -->
      <form action="/assessments/quiz/<%= quiz.id %>/submit" method="POST" id="quizForm">
        <input type="hidden" name="time_spent_secs" id="timeSpentSecs" value="0">

        <div style="display: flex; flex-direction: column; gap: 1.75rem; margin-bottom: 2.5rem;">
          <% questions.forEach((q, idx) => { %>
            <div class="panel" style="padding: 1.75rem;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; border-bottom: 1px solid var(--border-hairline); padding-bottom: 0.5rem;">
                <span class="index-tag accent">[ QUESTION 0<%= idx + 1 %> ]</span>
                <span class="badge badge-default"><%= q.points %> Points</span>
              </div>

              <div style="font-size: 1.05rem; font-weight: 600; color: var(--text-primary); margin-bottom: 1rem; line-height: 1.5;">
                <%= q.question_text %>
              </div>

              <% if (q.code_snippet) { %>
                <pre style="margin-bottom: 1.25rem;"><code><%= q.code_snippet %></code></pre>
              <% } %>

              <!-- Options Selection -->
              <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <% q.options.forEach(opt => { %>
                  <label style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.85rem 1rem; background-color: var(--bg-canvas); border: 1px solid var(--border-hairline); border-radius: var(--radius-sharp); cursor: pointer; transition: all var(--transition-fast);">
                    <input type="radio" name="answers[<%= q.id %>]" value="<%= opt.id %>" required style="margin-top: 0.25rem;">
                    <span style="font-size: 0.925rem; color: var(--text-primary); line-height: 1.5;">
                      <strong style="font-family: var(--font-mono); margin-right: 0.35rem;"><%= opt.id.toUpperCase() %>:</strong> <%= opt.text %>
                    </span>
                  </label>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem;">
          <a href="/courses/<%= quiz.course_slug %>" class="btn btn-secondary">
            Cancel & Return
          </a>
          <button type="submit" class="btn btn-primary btn-lg">
            Submit Assessment For Immediate Grading &rarr;
          </button>
        </div>
      </form>
    <% } %>

    <!-- Past Attempts Record -->
    <% if (attempts && attempts.length > 0) { %>
      <div class="panel">
        <div class="panel-header">
          <h3>Your Past Examination Attempts</h3>
          <span class="index-tag">[ ATTEMPT LOG ]</span>
        </div>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Attempt #</th>
                <th>Score</th>
                <th>Percentage</th>
                <th>Outcome</th>
                <th>Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% attempts.forEach((att, aIdx) => { %>
                <tr>
                  <td><code>#<%= attempts.length - aIdx %></code></td>
                  <td><strong><%= att.score %> / <%= att.total_points %></strong></td>
                  <td><span class="badge <%= att.percentage >= quiz.passing_score ? 'badge-success' : 'badge-danger' %>"><%= att.percentage %>%</span></td>
                  <td>
                    <% if (att.passed) { %>
                      <span class="badge badge-success">PASSED</span>
                    <% } else { %>
                      <span class="badge badge-danger">FAILED</span>
                    <% } %>
                  </td>
                  <td><%= att.completed_at %></td>
                  <td>
                    <a href="/assessments/quiz/<%= quiz.id %>/result/<%= att.id %>" class="btn btn-secondary btn-sm">
                      Inspect Review &rarr;
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script src="/js/quiz.js"></script>

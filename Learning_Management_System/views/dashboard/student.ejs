<div class="container section-editorial">
  <!-- Student Profile Bar -->
  <div class="panel" style="margin-bottom: 2.5rem; background-color: var(--bg-surface);">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <span class="index-tag accent">[ STUDENT WORKSPACE // ACADEMIC STANDING ]</span>
        <h1 style="font-size: 2rem; margin-top: 0.25rem;"><%= currentUser.name %></h1>
        <div style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
          <%= currentUser.headline || 'Undergraduate Systems Researcher' %> | <%= currentUser.email %>
        </div>
      </div>

      <div style="display: flex; gap: 1rem;">
        <a href="/courses" class="btn btn-secondary">
          Browse Course Directory
        </a>
        <a href="/auth/profile" class="btn btn-secondary">
          Settings
        </a>
      </div>
    </div>
  </div>

  <!-- Enrolled Courses Progression Grid -->
  <div style="margin-bottom: 3rem;">
    <div class="section-header">
      <div>
        <div class="index-tag accent" style="margin-bottom: 0.35rem;">[ ACTIVE CURRICULUM ]</div>
        <h2>Enrolled Courses & Progress</h2>
      </div>
    </div>

    <% if (enrollments && enrollments.length > 0) { %>
      <div class="grid-cols-2">
        <% enrollments.forEach(en => { %>
          <div class="panel" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                <span class="badge badge-accent"><%= en.course_code %></span>
                <span class="badge <%= en.progress_percent >= 100 ? 'badge-success' : 'badge-default' %>">
                  <%= en.progress_percent >= 100 ? 'COMPLETED' : 'IN PROGRESS' %>
                </span>
              </div>

              <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">
                <a href="/courses/<%= en.course_slug %>" style="color: inherit; text-decoration: none;">
                  <%= en.course_title %>
                </a>
              </h3>

              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1.25rem;">
                INSTRUCTOR: <%= en.instructor_name %> | <%= en.category %>
              </div>

              <!-- Live Progress Bar -->
              <div style="margin-bottom: 1.25rem;">
                <div style="display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 0.8rem; margin-bottom: 0.35rem;">
                  <span>Curriculum Coverage</span>
                  <strong><%= en.progress_percent %>%</strong>
                </div>
                <div class="progress-bar-container">
                  <div class="progress-bar-fill" style="width: <%= en.progress_percent %>%;"></div>
                </div>
                <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); margin-top: 0.35rem;">
                  <%= en.completed_lessons %> of <%= en.total_lessons %> lessons verified complete
                </div>
              </div>
            </div>

            <div style="border-top: 1px solid var(--border-hairline); padding-top: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
              <% if (en.progress_percent >= 100 && en.certificate_code) { %>
                <a href="/verify/<%= en.certificate_code %>" class="btn btn-secondary btn-sm" style="color: var(--status-success); border-color: var(--status-success);">
                  View Official Credential &rarr;
                </a>
              <% } else if (en.nextLesson) { %>
                <a href="/courses/<%= en.course_slug %>/learn/<%= en.nextLesson.slug %>" class="btn btn-primary btn-sm">
                  Resume: <%= en.nextLesson.title.substring(0, 24) %>... &rarr;
                </a>
              <% } else { %>
                <a href="/courses/<%= en.course_slug %>/learn" class="btn btn-secondary btn-sm">
                  Open Course Player &rarr;
                </a>
              <% } %>

              <a href="/courses/<%= en.course_slug %>" class="btn btn-secondary btn-sm">
                Syllabus
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="panel" style="text-align: center; padding: 3rem;">
        <h3 style="margin-bottom: 0.5rem;">You are not enrolled in any courses yet.</h3>
        <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Browse the engineering curriculum directory to register for courses.</p>
        <a href="/courses" class="btn btn-primary">Browse Course Catalog &rarr;</a>
      </div>
    <% } %>
  </div>

  <!-- Split Grid: Upcoming Assessments & Exam History -->
  <div class="grid-cols-2" style="margin-bottom: 3rem;">
    <!-- Laboratory Assignments -->
    <div class="panel">
      <div class="panel-header">
        <h3>Laboratory Benchmarks</h3>
        <span class="index-tag">[ LAB TRACKER ]</span>
      </div>

      <% if (assignments && assignments.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% assignments.forEach(a => { %>
            <div style="padding: 1rem; background-color: var(--bg-canvas); border: 1px solid var(--border-hairline);">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.35rem;">
                <span class="badge badge-accent" style="font-size: 0.7rem;"><%= a.course_code %></span>
                <% if (a.submission_status === 'graded') { %>
                  <span class="badge badge-success">GRADED: <%= a.student_score %> / <%= a.max_points %> PTS</span>
                <% } else if (a.submission_status) { %>
                  <span class="badge badge-warning">SUBMITTED</span>
                <% } else { %>
                  <span class="badge badge-default">DUE <%= a.due_date ? a.due_date.substring(0, 10) : 'OPEN' %></span>
                <% } %>
              </div>
              <div style="font-weight: 600; font-size: 0.925rem; margin-bottom: 0.5rem;"><%= a.title %></div>
              <a href="/assessments/assignment/<%= a.id %>" class="btn btn-secondary btn-sm">
                <%= a.submission_status ? 'Inspect Submission' : 'Submit Laboratory' %> &rarr;
              </a>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p style="font-size: 0.85rem; color: var(--text-muted);">No pending laboratory assignments for your enrolled courses.</p>
      <% } %>
    </div>

    <!-- Examination & Quiz History -->
    <div class="panel">
      <div class="panel-header">
        <h3>Examination Log</h3>
        <span class="index-tag">[ ATTEMPT HISTORY ]</span>
      </div>

      <% if (quizAttempts && quizAttempts.length > 0) { %>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Course</th>
                <th>Assessment</th>
                <th>Result</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% quizAttempts.forEach(qa => { %>
                <tr>
                  <td><code><%= qa.course_code %></code></td>
                  <td>
                    <div style="font-weight: 500; font-size: 0.85rem;"><%= qa.quiz_title %></div>
                  </td>
                  <td>
                    <span class="badge <%= qa.passed ? 'badge-success' : 'badge-danger' %>">
                      <%= qa.percentage %>% (<%= qa.passed ? 'PASS' : 'FAIL' %>)
                    </span>
                  </td>
                  <td>
                    <a href="/assessments/quiz/<%= qa.quiz_id %>/result/<%= qa.id %>" class="btn btn-secondary btn-sm" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">
                      Review
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p style="font-size: 0.85rem; color: var(--text-muted);">No examination attempts recorded yet.</p>
      <% } %>
    </div>
  </div>

  <!-- Earned Certificates -->
  <% if (certificates && certificates.length > 0) { %>
    <div class="panel">
      <div class="panel-header">
        <h3>Official Verified Credentials</h3>
        <span class="badge badge-success"><%= certificates.length %> ISSUED</span>
      </div>

      <div class="grid-cols-2">
        <% certificates.forEach(cert => { %>
          <div style="padding: 1.5rem; background-color: var(--bg-canvas); border: 1px solid var(--border-hairline); border-left: 4px solid var(--status-success);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
              <span class="badge badge-accent"><%= cert.course_code %></span>
              <span class="badge badge-success">VERIFIED</span>
            </div>
            
            <h4 style="font-size: 1.1rem; margin-bottom: 0.35rem;"><%= cert.course_title %></h4>
            <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1rem;">
              SERIAL: <%= cert.certificate_code %><br>
              ISSUED: <%= cert.issue_date %>
            </div>

            <a href="/verify/<%= cert.certificate_code %>" class="btn btn-primary btn-sm">
              View Verified Credential Record &rarr;
            </a>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>

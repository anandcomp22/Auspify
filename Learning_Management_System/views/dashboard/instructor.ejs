<div class="container section-editorial">
  <!-- Faculty Header -->
  <div class="panel" style="margin-bottom: 2.5rem; background-color: var(--bg-surface);">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <span class="index-tag accent">[ FACULTY WORKSPACE // CURRICULUM OPERATIONS ]</span>
        <h1 style="font-size: 2rem; margin-top: 0.25rem;"><%= currentUser.name %></h1>
        <div style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
          <%= currentUser.headline || 'Course Author & Faculty' %> | <%= currentUser.email %>
        </div>
      </div>

      <div style="display: flex; gap: 1rem;">
        <a href="/instructor/courses/new" class="btn btn-primary">
          + Author New Course
        </a>
        <a href="/courses" class="btn btn-secondary">
          Public Catalog
        </a>
      </div>
    </div>
  </div>

  <!-- Submissions Awaiting Grading (Priority Queue) -->
  <div class="panel" style="margin-bottom: 3rem; border-left: 4px solid var(--status-warning);">
    <div class="panel-header">
      <div>
        <h3 style="color: var(--status-warning);">Laboratory Submissions Awaiting Faculty Evaluation</h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">Student deliverables queued for rubric grading.</p>
      </div>
      <span class="badge badge-warning"><%= pendingSubmissions ? pendingSubmissions.length : 0 %> PENDING</span>
    </div>

    <% if (pendingSubmissions && pendingSubmissions.length > 0) { %>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Course</th>
              <th>Assignment</th>
              <th>Student</th>
              <th>Submitted Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% pendingSubmissions.forEach(sub => { %>
              <tr>
                <td><span class="badge badge-accent"><%= sub.course_code %></span></td>
                <td><strong><%= sub.assignment_title %></strong></td>
                <td>
                  <div><%= sub.student_name %></div>
                  <div style="font-family: var(--font-mono); font-size: 0.725rem; color: var(--text-muted);"><%= sub.student_email %></div>
                </td>
                <td><%= sub.submitted_at %></td>
                <td>
                  <a href="/assessments/assignment/<%= sub.assignment_id %>/grading/<%= sub.id %>" class="btn btn-accent btn-sm">
                    Grade Submission &rarr;
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="font-size: 0.875rem; color: var(--text-muted); padding: 1.5rem; text-align: center;">
        Zero pending submissions in your grading queue. All candidate laboratory reports are graded.
      </p>
    <% } %>
  </div>

  <!-- Authored Courses Roster -->
  <div style="margin-bottom: 3rem;">
    <div class="section-header">
      <div>
        <div class="index-tag accent" style="margin-bottom: 0.35rem;">[ CURRICULUM ASSETS ]</div>
        <h2>Your Authored Engineering Courses (<%= courses.length %>)</h2>
      </div>
      <a href="/instructor/courses/new" class="btn btn-secondary btn-sm">
        + Create Course
      </a>
    </div>

    <% if (courses && courses.length > 0) { %>
      <div class="grid-cols-2">
        <% courses.forEach(c => { %>
          <div class="panel" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                <span class="badge badge-accent"><%= c.code %></span>
                <span class="badge <%= c.status === 'published' ? 'badge-success' : 'badge-default' %>">
                  <%= c.status.toUpperCase() %>
                </span>
              </div>

              <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">
                <a href="/instructor/courses/<%= c.id %>/curriculum" style="color: inherit; text-decoration: none;">
                  <%= c.title %>
                </a>
              </h3>

              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1.25rem;">
                <%= c.category %> | <%= c.difficulty %> | <%= c.estimated_hours %> Hours
              </div>

              <div class="grid-cols-4" style="background-color: var(--bg-canvas); padding: 0.85rem; border: 1px solid var(--border-hairline); margin-bottom: 1.25rem; text-align: center;">
                <div>
                  <div style="font-family: var(--font-mono); font-weight: 700; font-size: 1.15rem;"><%= c.modules_count %></div>
                  <div style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-muted);">MODULES</div>
                </div>
                <div>
                  <div style="font-family: var(--font-mono); font-weight: 700; font-size: 1.15rem;"><%= c.lessons_count %></div>
                  <div style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-muted);">LESSONS</div>
                </div>
                <div>
                  <div style="font-family: var(--font-mono); font-weight: 700; font-size: 1.15rem;"><%= c.enrolled_students %></div>
                  <div style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-muted);">STUDENTS</div>
                </div>
                <div>
                  <div style="font-family: var(--font-mono); font-weight: 700; font-size: 1.15rem;"><%= c.quizzes_count %></div>
                  <div style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-muted);">QUIZZES</div>
                </div>
              </div>
            </div>

            <div style="border-top: 1px solid var(--border-hairline); padding-top: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
              <a href="/instructor/courses/<%= c.id %>/curriculum" class="btn btn-primary btn-sm">
                Curriculum Builder &rarr;
              </a>
              <div style="display: flex; gap: 0.5rem;">
                <a href="/instructor/courses/<%= c.id %>/edit" class="btn btn-secondary btn-sm">
                  Edit Metadata
                </a>
                <a href="/courses/<%= c.slug %>" class="btn btn-secondary btn-sm">
                  Preview
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="panel" style="text-align: center; padding: 3rem;">
        <h3 style="margin-bottom: 0.5rem;">No authored courses in your faculty catalog.</h3>
        <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Create your first engineering course to start adding modules and lessons.</p>
        <a href="/instructor/courses/new" class="btn btn-primary">+ Author New Course</a>
      </div>
    <% } %>
  </div>

  <!-- Recent Student Quiz Attempts -->
  <div class="panel">
    <div class="panel-header">
      <h3>Recent Candidate Examination Submissions</h3>
      <span class="index-tag">[ TELEMETRY STREAM ]</span>
    </div>

    <% if (recentQuizAttempts && recentQuizAttempts.length > 0) { %>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Course</th>
              <th>Candidate</th>
              <th>Quiz Assessment</th>
              <th>Score</th>
              <th>Status</th>
              <th>Completed Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% recentQuizAttempts.forEach(qa => { %>
              <tr>
                <td><code><%= qa.course_code %></code></td>
                <td><strong><%= qa.student_name %></strong></td>
                <td><%= qa.quiz_title %></td>
                <td><strong><%= qa.score %> / <%= qa.total_points %></strong></td>
                <td>
                  <span class="badge <%= qa.passed ? 'badge-success' : 'badge-danger' %>">
                    <%= qa.percentage %>% (<%= qa.passed ? 'PASS' : 'FAIL' %>)
                  </span>
                </td>
                <td><%= qa.completed_at %></td>
                <td>
                  <a href="/assessments/quiz/<%= qa.quiz_id %>/result/<%= qa.id %>" class="btn btn-secondary btn-sm" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">
                    Inspect Attempt
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p style="font-size: 0.85rem; color: var(--text-muted); text-align: center; padding: 2rem;">
        Zero recent examination attempts logged for your courses.
      </p>
    <% } %>
  </div>
</div>

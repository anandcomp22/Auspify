<% if (typeof flash !== 'undefined') { %>
  <% if (flash.success) { %>
    <div class="alert alert-success">
      <span><%= flash.success %></span>
      <button type="button" class="alert-dismiss" style="background: none; border: none; cursor: pointer; color: inherit; font-size: 1.1rem; line-height: 1;">&times;</button>
    </div>
  <% } %>

  <% if (flash.error) { %>
    <div class="alert alert-error">
      <span><%= flash.error %></span>
      <button type="button" class="alert-dismiss" style="background: none; border: none; cursor: pointer; color: inherit; font-size: 1.1rem; line-height: 1;">&times;</button>
    </div>
  <% } %>
<% } %>

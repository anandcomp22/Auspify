<div class="container section-editorial">
  <div style="max-width: 900px; margin: 0 auto;">
    <!-- Breadcrumb & Direct Search Bar -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; font-family: var(--font-mono); font-size: 0.8rem;">
        <a href="/" style="color: var(--text-muted); text-decoration: none;">HOME</a>
        <span style="color: var(--border-hairline);">/</span>
        <span style="color: var(--accent-primary);">ACADEMIC CREDENTIAL VERIFICATION</span>
      </div>

      <form onsubmit="event.preventDefault(); window.location.href='/verify/' + document.getElementById('searchCertCode').value.trim();" style="display: flex; gap: 0.5rem;">
        <input type="text" id="searchCertCode" class="form-input" placeholder="Search Serial Code..." style="width: 240px; padding: 0.35rem 0.65rem; font-size: 0.8rem; font-family: var(--font-mono);">
        <button type="submit" class="btn btn-secondary btn-sm">Verify</button>
      </form>
    </div>

    <% if (cert) { %>
      <!-- High-End Editorial Certificate Frame -->
      <div class="panel" style="padding: 4rem 3.5rem; background-color: #FFFFFF; border: 2px solid var(--border-strong); position: relative; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <!-- Top Certificate Monogram and Header -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid var(--text-primary); padding-bottom: 1.5rem; margin-bottom: 2.5rem;">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <div class="brand-monogram" style="width: 48px; height: 48px; font-size: 1.25rem;">A</div>
            <div>
              <div style="font-family: var(--font-sans); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em;">
                AUSPIFY INSTITUTE OF TECHNOLOGY
              </div>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">
                OFFICIAL RECORD OF ACADEMIC COMPLETION & MASTERY
              </div>
            </div>
          </div>

          <div style="text-align: right;">
            <span class="badge badge-success" style="font-size: 0.8rem; padding: 0.35rem 0.75rem;">
              CRYPTOGRAPHICALLY VERIFIED
            </span>
            <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">
              SERIAL: <%= cert.certificate_code %>
            </div>
          </div>
        </div>

        <!-- Certificate Body -->
        <div style="text-align: center; margin: 3rem 0;">
          <div class="index-tag accent" style="margin-bottom: 1rem;">
            [ THIS FORMAL CREDENTIAL IS CONFERRED UPON ]
          </div>

          <h2 style="font-size: 2.75rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 1.25rem; color: var(--text-primary);">
            <%= cert.student_name %>
          </h2>

          <p style="font-size: 1.05rem; color: var(--text-secondary); max-width: 680px; margin: 0 auto 1.5rem auto; line-height: 1.6;">
            Having fulfilled all laboratory requirements, achieved passing grades across all timed examinations, and successfully mastered the full technical curriculum of
          </p>

          <div style="display: inline-block; padding: 0.75rem 2rem; background-color: var(--bg-canvas); border: 1px solid var(--border-hairline); margin-bottom: 1.5rem;">
            <div style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--accent-primary); font-weight: 600; margin-bottom: 0.25rem;">
              <%= cert.course_code %> // <%= cert.category.toUpperCase() %>
            </div>
            <h3 style="font-size: 1.65rem; color: var(--text-primary); margin: 0;">
              <%= cert.course_title %>
            </h3>
          </div>

          <% if (cert.grade_summary) { %>
            <div style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto;">
              <%= cert.grade_summary %>
            </div>
          <% } %>
        </div>

        <!-- Faculty Signatures and Date -->
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; border-top: 1px solid var(--border-hairline); padding-top: 2rem; margin-top: 3.5rem; text-align: left;">
          <div>
            <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">
              FACULTY RESEARCHER
            </div>
            <div style="font-weight: 700; font-size: 0.95rem; margin-top: 0.25rem;"><%= cert.instructor_name %></div>
            <div style="font-size: 0.75rem; color: var(--text-muted);"><%= cert.instructor_headline %></div>
          </div>

          <div>
            <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">
              ISSUE TIMESTAMP
            </div>
            <div style="font-weight: 700; font-size: 0.95rem; margin-top: 0.25rem;"><%= cert.issue_date %></div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Accredited Curriculum Verification</div>
          </div>

          <div>
            <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">
              INSTITUTIONAL REGISTRAR
            </div>
            <div style="font-weight: 700; font-size: 0.95rem; margin-top: 0.25rem;">Dr. Helen Vance</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Director of Academic Infrastructure</div>
          </div>
        </div>

        <!-- Cryptographic Ledger Footer -->
        <div style="margin-top: 2.5rem; padding: 1rem; background-color: var(--bg-canvas); border: 1px solid var(--border-hairline); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
          <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted);">
            VALIDATION DIGEST: <strong style="color: var(--text-primary);"><%= cert.verification_hash %></strong>
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--status-success);">
            PUBLIC LEDGER: VERIFIED & IMMUTABLE
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem;">
        <a href="/courses/<%= cert.course_id %>" class="btn btn-secondary">
          &larr; View Course Syllabus
        </a>

        <button type="button" class="btn btn-primary" onclick="window.print()">
          Print Official Credential Document
        </button>
      </div>

    <% } else { %>
      <!-- Verification Failure Card -->
      <div class="panel" style="text-align: center; padding: 4rem 2rem;">
        <div class="index-tag" style="color: var(--status-danger); margin-bottom: 1rem;">
          [ CRYPTOGRAPHIC VERIFICATION FAILURE ]
        </div>

        <h2 style="font-size: 1.85rem; margin-bottom: 0.75rem;">
          No Credential Matches Serial "<%= searchedCode %>"
        </h2>

        <p style="color: var(--text-secondary); max-width: 540px; margin: 0 auto 2rem auto; line-height: 1.6;">
          The provided certificate code could not be verified in the institutional database. Please double-check the alphanumeric sequence or test with the verified sample credential below.
        </p>

        <a href="/verify/AUSPIFY-LMS-2026-88F4A19E" class="btn btn-primary">
          Inspect Sample Verified Credential (AUSPIFY-LMS-2026-88F4A19E) &rarr;
        </a>
      </div>
    <% } %>
  </div>
</div>
